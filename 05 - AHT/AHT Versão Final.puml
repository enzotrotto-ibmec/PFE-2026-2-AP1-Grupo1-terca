@startuml
title Fluxo Completo do Site - Home, One to One e PKZ

start

:Usuário acessa a Página Principal (Home);

partition "Página Principal - Cabeçalho e Conteúdo" {
  :Visualiza informações sobre as empresas e fotos dos integrantes;
  
  if (Ação de Navegação no Cabeçalho ou Caixas) then (Opção One to One)
    :Clica em "arraste para visita - One to One" / "Personal Training - Quero conhecer";
    goto pag_one_to_one
  else (Opção PKZ)
    :Clica em "Arraste para visitar PKZ" / "PKZ - Quero conhecer";
    goto pag_pkz
  else (Redes Sociais Rodapé)
    :Clica no Instagram da PKZ ou One to One;
    :Redirecionado para o perfil do Instagram selecionado;
    stop
  endif
}

partition "Página One to One" {
  label pag_one_to_one
  :Acessa cabeçalho "Studio One to One - Sobre | Serviços | Localização | Contato";
  :Visualiza seção "Sobre a One to One";
  :Explora soluções exclusivas (Personal Training, Fisioterapia, Nutricionista);
  :Visualiza localização das unidades no rodapé;

  if (Clica no menu "Contato"?) then (Sim)
    goto fluxo_agendamento
  else (Não)
    if (Clica no Instagram) then (Sim)
      :Redirecionado para o Instagram da One to One;
    endif
    stop
  endif
}